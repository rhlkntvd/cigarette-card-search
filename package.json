{
  "name": "cigarette-card-search",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "fetch:cards": "node --env-file=.env --import tsx scripts/fetch-cards.ts",
    "inspect:cards": "node --import tsx scripts/inspect-cards.ts",
    "normalize:cards": "node --import tsx scripts/normalize-cards.ts",
    "verify:cards": "node --import tsx scripts/verify-cards.ts",
    "compare:cards": "node --import tsx scripts/compare-cards.ts",
    "search:cards": "node --env-file=.env --import tsx scripts/search-cards.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "next": "^16.4.5",
    "pgvector": "^0.3.0",
    "postgres": "^3.4.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
